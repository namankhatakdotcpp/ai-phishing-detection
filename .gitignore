__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.DS_Store
*.egg-info/

data/raw/*
data/generated/*
data/processed/*
!data/raw/.gitkeep
!data/generated/.gitkeep
!data/processed/.gitkeep

reports/*.png
reports/*.csv
reports/*.jsonl
!reports/.gitkeep
# Phase 7's illustrative report assets are committed as the course
# deliverable (see PROJECT_BRIEF.md, Phase 7) — unlike phase3_/phase4_
# outputs, which are only produced by running against real downloaded data.
!reports/phase7_*

.env

# Web Store packaging output -- regenerated by scripts/package_extension.py,
# never hand-edited, no reason to commit a build artifact.
/release/
/phishshield-extension.zip

# tests_js/'s installed dependencies (jsdom etc.) -- package.json and
# package-lock.json ARE committed for reproducibility; run `npm install`
# inside tests_js/ to regenerate this.
tests_js/node_modules/

# Real third-party page content fetched for the hard-negative evaluation
# (Section 3.6, FINAL_REPORT.md) -- not redistributed, same policy as
# data/raw/*. The fetch is a plain documented curl one-liner, reproducible
# without committing the pages themselves.
tests_js/hard_negative_fixtures/
