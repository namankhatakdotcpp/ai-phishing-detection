# Copy to .env (gitignored, never commit) and fill in ONE of these
# depending on which --provider you use with generate_llm_dataset.py.
# Never paste the real value into a chat/agent session or a CLI argument.

# --provider gemini (default) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --provider anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
