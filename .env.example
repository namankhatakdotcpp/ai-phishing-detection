# Copy to .env (gitignored, never commit) and fill in ONE of these
# depending on which --provider you use with generate_llm_dataset.py.
# Never paste the real value into a chat/agent session or a CLI argument.

# --provider gemini (default) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --provider anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Demo API (src/phishshield/api/) ---
# All have safe local-dev defaults (see api/config.py) -- only needed
# for production deployment. Not secrets; fine to set as plain deploy
# platform environment variables, not files.
PHISHSHIELD_ENV=development
PHISHSHIELD_CORS_ORIGINS=*
PHISHSHIELD_RATE_LIMIT_PER_MINUTE=60
PHISHSHIELD_MAX_REQUEST_BYTES=65536
